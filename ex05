#include <stdio.h>

int main(){
    //declaracao de variaveis
    float nota1, nota2, nota3;
    float media;
    //entrada de dados
    printf("digite a primeira nota:");
    scanf("%f", &nota1);
    printf("digite a segunda nota:");
    scanf("%f", &nota2);
    printf("digite a terceira nota:");
    scanf("%f", &nota3);
    //processamento
    media = (nota1 + nota2 + nota3) / 3;
    //saida
    printf("a media aritmetica e:%2f", media);
    
    return 0;
}
